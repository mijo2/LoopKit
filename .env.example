# Copy to `.env` (gitignored) and fill in ONE provider key. `make` loads this
# file automatically; for anything else, `set -a; source .env; set +a`.
# No quotes around values.

XAI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional. Only needed when more than one key is set, or to change the model.
# LOOPKIT_PROVIDER=openai
# LOOPKIT_MODEL=gpt-6.1-sol

# Optional. A second model for the checks; the drafts stay on LOOPKIT_MODEL.
# LOOPKIT_CHECK_MODEL=gpt-6.1-mini
# LOOPKIT_CHECK_PROVIDER=anthropic
# LOOPKIT_CHECK_BASE_URL=http://localhost:11434/v1

# Optional. Any OpenAI-compatible server (Ollama, vLLM, LM Studio, ...).
# LOOPKIT_BASE_URL=http://localhost:11434/v1
# LOOPKIT_API_KEY=

# Optional. A cap on the tokens one ask may spend across all of its calls, and
# how it is held: soft (a turn at a time, default) or hard (a call at a time).
# LOOPKIT_TOKEN_BUDGET=20000
# LOOPKIT_TOKEN_BUDGET_MODE=soft

# Optional. Hold each draft to a length: auto, or a number of characters.
# LOOPKIT_RESPONSE_LENGTH=auto
